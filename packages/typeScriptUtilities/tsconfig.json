{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "ES2022.Intl", "DOM"],
    "types": []
  },
  "include": ["utils/**/*.ts", "tests/**/*.ts"]
}
